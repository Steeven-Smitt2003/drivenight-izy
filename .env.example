HOST=127.0.0.1
PORT=3000
DB_PATH=./server/data/drivenight.sqlite
# Leave empty to use local SQLite; set to a managed PostgreSQL connection URL for beta preparation.
DATABASE_URL=
# PostgreSQL demo records are opt-in and must never be enabled in production.
SEED_DEMO_DATA=false
JWT_SECRET=replace-this-local-development-secret
# Production transactional email (Brevo Free); keep the API key server-side.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DriveNight
# Real email sends require explicit opt-in; keep false for local development.
EMAIL_DELIVERY_ENABLED=false
# Exact HTTPS origin of the deployed web client; leave empty when using the local Vite proxy.
CLIENT_ORIGIN=
VITE_API_BASE_URL=
