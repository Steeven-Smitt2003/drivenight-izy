HOST=127.0.0.1
PORT=3000
DB_PATH=./server/data/drivenight.sqlite
# Optional PostgreSQL for the legacy Fastify service; leave empty for local SQLite.
# The current app uses Supabase directly through VITE_SUPABASE_* instead.
DATABASE_URL=
# PostgreSQL demo records are opt-in and must never be enabled in production.
SEED_DEMO_DATA=false
JWT_SECRET=replace-this-local-development-secret
# Production transactional email (Brevo Free); keep the API key server-side.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DriveNight
# Real email sends require explicit opt-in; keep false for local development.
EMAIL_DELIVERY_ENABLED=false
# Exact HTTPS origin of the deployed web client; leave empty when using the local Vite proxy.
CLIENT_ORIGIN=
# Supabase client configuration (public values only; never use the service_role key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy Fastify API origin only; leave empty when the client uses Supabase directly.
VITE_API_BASE_URL=
# Firebase App Distribution publishes Android test builds only; no Firebase Hosting/PWA deployment.
FIREBASE_APP_ID=
FIREBASE_TESTER_GROUPS=
FIREBASE_TESTER_EMAILS=
FIREBASE_RELEASE_NOTES=Version de test DriveNight
